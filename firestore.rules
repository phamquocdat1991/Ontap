rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The browser uses Firebase Authentication only.
    // All application data is accessed through the Express/Vercel API with Firebase Admin SDK.
    // Admin SDK bypasses Firestore Security Rules, so direct client data access is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
